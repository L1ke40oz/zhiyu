# 服务端配置；复制为 .env 后填写，密钥不要填进前端代码。
PORT=3100
HOST=0.0.0.0
DATA_DIR=./data
PUBLIC_ORIGIN=
# 仅在已核对反向代理来源时设置，例如 loopback。
TRUST_PROXY=
# Compose 宿主机发布地址和端口；OpenResty 的网络可达性需实际确认。
BIND_ADDRESS=127.0.0.1
APP_PORT=3100

# 可选：兼容 /chat/completions 的服务，地址包含 /v1 等实际前缀。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=60000

# 可选：兼容 /embeddings 的向量服务。未配置时使用原文关键词检索。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 本地 OCR 不需要 API key。初次安装后使用本地语言包。
OCR_ENABLED=true
OCR_LANGUAGES=chi_sim+eng
# 可选：视觉模型，支持含图片的 /chat/completions 消息。
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# 已集成游戏，留空使用 /party/；也可填写独立部署的 HTTPS 游戏地址。
PARTY_URL=
