# school.luminestella.top 的服务端生产配置。首次部署复制到项目根目录 .env。
PUBLIC_ORIGIN=https://school.luminestella.top
HOST=0.0.0.0
PORT=3100
DATA_DIR=/app/data
# 先留空；核对 Docker 内实际代理来源后，填受控代理 IP 或 CIDR。
TRUST_PROXY=
BIND_ADDRESS=127.0.0.1
APP_PORT=3100

# 站点默认 NewAPI；Base URL 包含实际 /v1 前缀，密钥仅填写在 VPS 上。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=60000

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

OCR_ENABLED=true
OCR_LANGUAGES=chi_sim+eng
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
PARTY_URL=
